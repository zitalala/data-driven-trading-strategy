# Copy this file to .env and set your own Alpha Vantage key.
ALPHAVANTAGE_API_KEY=your_api_key_here
ALPHAVANTAGE_REQUESTS_PER_MINUTE=70
# Retry each failed stock daily ticker up to 3 times; tolerate at most this many omissions.
STOCKDB_STOCK_DAILY_MAX_SKIPPED_TICKERS=1
# Retry each failed overview/dividend/earnings ticker up to 3 times;
# after that, record and skip at most 500 unavailable symbols per dataset.
STOCKDB_STOCK_MARKET_TICKER_RETRIES=3
STOCKDB_STOCK_MARKET_MAX_SKIPPED_TICKERS=500

# Generated daily tables: {prefix}_{period}_from_{layer}
STOCKDB_STOCK_DAILY_TABLE_PREFIX=stock_metadata
STOCKDB_ETF_DAILY_TABLE_PREFIX=etf_metadata
STOCKDB_DAILY_TABLE_LAYER=daily
STOCKDB_DAILY_PERIODS=1d,1w,1mo,3mo,6mo,12mo
STOCKDB_ENRICHED_TABLE_SUFFIX=with_divergences_and_indicators

# Generated intraday tables: {prefix}_{period}_from_{layer}
STOCKDB_INTRADAY_TABLE_PREFIX=stock_metadata
STOCKDB_INTRADAY_TABLE_LAYER=intraday
STOCKDB_INTRADAY_PERIODS=30min,1h,4h

# Fixed table names; update these if you rename the corresponding tables.
STOCKDB_TABLE_OVERVIEW=stocks_overview
STOCKDB_TABLE_DIVIDENDS=stocks_dividends
STOCKDB_TABLE_EARNINGS_CALENDAR=stocks_earnings_calendar
STOCKDB_TABLE_MARKET=stocks_market
STOCKDB_STOCK_TABLE_REAL_DIVIDEND_YIELD=stock_real_dividend_yield
STOCKDB_ETF_TABLE_REAL_DIVIDEND_YIELD=etf_real_dividend_yield
STOCKDB_STOCK_TABLE_DAILY_SNAPSHOT=stock_daily_snapshot
STOCKDB_ETF_TABLE_DAILY_SNAPSHOT=etf_daily_snapshot
STOCKDB_STOCK_TABLE_DIVERGENCES_AND_INDICATORS_ALL=stock_divergences_and_indicators_all
STOCKDB_ETF_TABLE_DIVERGENCES_AND_INDICATORS_ALL=etf_divergences_and_indicators_all
STOCKDB_ETF_TABLE_MARKET=etf_market
STOCKDB_ETF_TABLE_THEME=etf_theme
STOCKDB_ETF_TABLE_PREVIEW=etf_preview
STOCKDB_ETF_TABLE_VIEW=etf_view
STOCKDB_ETF_TABLE_OVERVIEW=etf_overview
STOCKDB_ETF_TABLE_SECTOR_STOCK_MAPPING=etf_sector_stock_mapping
STOCKDB_ETF_TABLE_TRADING_DAILY=etf_trading_daily
STOCKDB_TABLE_MARKET_CONTEXT_DAILY=market_context_daily
STOCKDB_TABLE_MARKET_CONTEXT_INDICATORS=market_context_indicators
STOCKDB_TABLE_EXAMPLE_THEME_SUMMARY=example_theme_summary
